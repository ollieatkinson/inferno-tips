{
  "name": "inferno-tips",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "format": "prettier --write src tests *.ts *.mjs *.json *.md",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "deploy:api:staging": "npm run build && wrangler deploy --config worker/wrangler.jsonc --env staging",
    "deploy:api:production": "wrangler deploy --config worker/wrangler.jsonc --env production",
    "test:api": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.3",
    "better-auth": "1.7.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260918.0-alpha",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
