{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inferno-tips-api-local",
  "main": "index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "vars": {
    "CLOUD_ENABLED": "true",
    "APP_ORIGIN": "http://localhost:4321",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ALLOW_TEST_TURNSTILE": "true",
    "ACCOUNTS_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inferno-tips-local",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "READ_LIMIT",
      "namespace_id": "1011",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "RUN_LIMIT",
      "namespace_id": "1021",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1031",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "ACCOUNT_LIMIT",
      "namespace_id": "1041",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "inferno-tips-api-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "CLOUD_ENABLED": "true",
        "APP_ORIGIN": "https://inferno-tips-api-staging.oliveratkinson.workers.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE9s_YZTYoo093V2",
        "ALLOW_TEST_TURNSTILE": "false",
        "ACCOUNTS_ENABLED": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inferno-tips-staging",
          "database_id": "c9b84a00-f42c-4b27-9db0-34834a4db88c",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "WRITE_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "READ_LIMIT",
          "namespace_id": "1012",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "RUN_LIMIT",
          "namespace_id": "1022",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
        {
          "name": "AUTH_LIMIT",
          "namespace_id": "1032",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "ACCOUNT_LIMIT",
          "namespace_id": "1042",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
      "assets": {
        "directory": "../dist",
        "run_worker_first": ["/api/v1/*"],
      },
    },
    "production": {
      "name": "inferno-tips-api",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "inferno.tips/api/v1/*",
          "zone_name": "inferno.tips",
        },
      ],
      "vars": {
        "CLOUD_ENABLED": "true",
        "APP_ORIGIN": "https://inferno.tips",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAE9s_pD1qBMp1fzO",
        "ALLOW_TEST_TURNSTILE": "false",
        "ACCOUNTS_ENABLED": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inferno-tips-production",
          "database_id": "f99af28a-83b9-4cb5-bea3-a1019f8b9c6a",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "WRITE_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "READ_LIMIT",
          "namespace_id": "1013",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "RUN_LIMIT",
          "namespace_id": "1023",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
        {
          "name": "AUTH_LIMIT",
          "namespace_id": "1033",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "ACCOUNT_LIMIT",
          "namespace_id": "1043",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
  },
  "account_id": "70752272304e0c63623f7f6ac58f4ba7",
  "compatibility_flags": ["nodejs_compat"],
}
